# QDO static site. Upload alongside index.html in the domain document root.
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/otf .otf
  AddType font/ttf .ttf
  AddType video/mp4 .mp4
  AddType application/javascript .js
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lazoghly\-park/?$ project-lazoghly-park.html [R=301,L,NE]
  RewriteRule ^concentrix\-for\-mavens\-consulting/?$ project-concentrix-for-mavens-consulting.html [R=301,L,NE]
